# ==============================================================================
# CLAIMEXCHANGE - ENVIRONMENT VARIABLES
# ==============================================================================

# Google Gemini API Key (Required for Claim AI text audit & vision OCR)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Credentials (Optional for local testing; Required for production cloud DB)
# Found in your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
